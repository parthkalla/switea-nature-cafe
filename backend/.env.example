PORT=5000
NODE_ENV=development
# For SQLite (local default):
DATABASE_URL="file:./switea.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/switea_db?schema=public"

JWT_SECRET=your_secure_jwt_secret_change_in_production
FRONTEND_URL=http://localhost:5173

# Optional WhatsApp Cloud API loyalty notifications
# Create an approved template named switea_loyalty_update with 6 body variables:
# name, order number, food earned, food balance, coffee earned, coffee balance.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=switea_loyalty_update
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0

# Marketplace/POS bridge. These are enabled only after the platform approves
# your restaurant/POS integration and gives you webhook/API credentials.
SWIGGY_WEBHOOK_SECRET=
ZOMATO_WEBHOOK_SECRET=
SWIGGY_API_TOKEN=
ZOMATO_API_TOKEN=
SWIGGY_ORDER_STATUS_URL=
ZOMATO_ORDER_STATUS_URL=

# Optional Online Payment Configuration (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional S3-compatible Storage (Local disk storage used by default)
STORAGE_TYPE=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
