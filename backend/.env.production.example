# ====================================================
# ROASTFUZE CAFE - PRODUCTION ENVIRONMENT (.env)
# Host OS: Amazon Linux 2023 / Amazon Linux 2 (AWS EC2)
# ====================================================

PORT=5000
NODE_ENV=production

# Production Database (PostgreSQL on Amazon Linux / RDS)
DATABASE_URL="postgresql://roastfuze_user:YourSecureDbPassword123@localhost:5432/roastfuze_db?schema=public"

# Security & Sessions
JWT_SECRET="roastfuze_prod_jwt_super_secret_key_jaipur_2026_x99a"

# Public Domain / EC2 Public IP / CloudFront URL
FRONTEND_URL="https://roastfuze.com"

# Payment Gateways (Optional Razorpay Live credentials)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"

# Local / S3 Uploads
STORAGE_TYPE=local
